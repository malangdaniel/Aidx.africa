# AiDx Elite — Environment Variables Template
# Copy this file to .env.local and fill in your values.

# ─── AiDx Elite Feature Flag ─────────────────────────────────────────────────
# Set to "true" to enable the Elite Health Coach tab for all authenticated users.
# Set to "false" to hide it globally (zero API calls made).
VITE_ELITE_ENABLED=false

# ─── Google Fit OAuth ────────────────────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console (Fitness API must be enabled)
# Redirect URI must be: {your-domain}/integrations/google-fit/callback
VITE_GOOGLE_FIT_CLIENT_ID=

# ─── Supabase (already in project) ───────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─── Gemini (already in project) ─────────────────────────────────────────────
VITE_GEMINI_API_KEY=
